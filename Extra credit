"""
solve.py
Computational solution for the Lightweight Quadcopter Frame Design Optimization.
Requires:
    pip install numpy scipy matplotlib
"""

import numpy as np
from scipy.optimize import minimize
import matplotlib.pyplot as plt

# -----------------------------
# Constants (SI units)
# -----------------------------
rho = 1520.0          # kg/m^3
E = 125e9             # Pa
F_motor = 9.0         # N
n = 1.5
F = n * F_motor

sigma_allow = 905e6   # Pa

B = 100e-3            # m
Dp = 241.3e-3         # m
Cmin = 10e-3          # m

# Bounds (m)
bounds = [
    (100e-3,220e-3),   # L
    (10e-3,30e-3),     # b
    (10e-3,40e-3),     # h
    (0.5e-3,3e-3)      # t
]

history=[]

def area(b,h,t):
    return b*h-(b-2*t)*(h-2*t)

def inertia(b,h,t):
    return (b*h**3-(b-2*t)*(h-2*t)**3)/12

def objective(x):
    L,b,h,t=x
    return 4*rho*L*area(b,h,t)

def clearance(x):
    L,b,h,t=x
    return (B+np.sqrt(2)*L)-(Dp+Cmin)

def geom1(x):
    return x[1]-2*x[3]

def geom2(x):
    return x[2]-2*x[3]

def stress_margin(x):
    L,b,h,t=x
    I=inertia(b,h,t)
    sigma=F*L*(h/2)/I
    return sigma_allow-sigma

def deflection_margin(x):
    L,b,h,t=x
    I=inertia(b,h,t)
    delta=F*L**3/(3*E*I)
    return 0.01*L-delta

constraints=[
    {'type':'ineq','fun':clearance},
    {'type':'ineq','fun':geom1},
    {'type':'ineq','fun':geom2},
    {'type':'ineq','fun':stress_margin},
    {'type':'ineq','fun':deflection_margin},
]

def callback(xk):
    history.append(objective(xk)*1000)

x0=np.array([150e-3,20e-3,20e-3,1.5e-3])

result=minimize(
    objective,
    x0,
    method="SLSQP",
    bounds=bounds,
    constraints=constraints,
    callback=callback,
    options={"disp":True,"maxiter":300}
)

L,b,h,t=result.x
I=inertia(b,h,t)
sigma=F*L*(h/2)/I
delta=F*L**3/(3*E*I)

print("\nOptimal Design")
print("---------------------------")
print(f"L = {L*1000:.3f} mm")
print(f"b = {b*1000:.3f} mm")
print(f"h = {h*1000:.3f} mm")
print(f"t = {t*1000:.3f} mm")
print(f"Mass = {objective(result.x)*1000:.3f} g")
print(f"Stress = {sigma/1e6:.2f} MPa")
print(f"Allowable = {sigma_allow/1e6:.2f} MPa")
print(f"Deflection = {delta*1000:.4f} mm")
print(f"Limit = {0.01*L*1000:.4f} mm")
print(f"Clearance margin = {clearance(result.x)*1000:.3f} mm")

with open("results.txt","w") as f:
    f.write("Optimal Design\n")
    f.write(f"L = {L*1000:.3f} mm\n")
    f.write(f"b = {b*1000:.3f} mm\n")
    f.write(f"h = {h*1000:.3f} mm\n")
    f.write(f"t = {t*1000:.3f} mm\n")
    f.write(f"Mass = {objective(result.x)*1000:.3f} g\n")
    f.write(f"Stress = {sigma/1e6:.2f} MPa\n")
    f.write(f"Deflection = {delta*1000:.4f} mm\n")

if history:
    plt.figure(figsize=(6,4))
    plt.plot(history,marker='o')
    plt.xlabel("Iteration")
    plt.ylabel("Objective (g)")
    plt.title("Optimization Convergence")
    plt.grid(True)
    plt.tight_layout()
    plt.savefig("convergence.png",dpi=300)

print("\nFiles generated:")
print("  results.txt")
print("  convergence.png")
